{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "server= .; Database = HotelDatabase; Trusted_Connection = True; TrustServerCertificate = True"
  },
  "RedisSettings": {
    "ConnectionString": ""
  },
  "JWT": {
    "audience": "MyClients",
    "issuer": "https://localhost:7048",
    "expires": 1,
    "ClockSkewMinutes": 5,
    "Key": "a-string-secret-at-least-256-bits-long"
  },
  // For Resolver Image Get Full Path
  "BasePictureUrl": "https://localhost:7048",
  // For Attachment Service
  "FileSettings": {
    "FolderName": "Images",
    "MaxSize": 2097152,
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".webp" ],
    "AllowedContentTypes": [ "image/png", "image/jpeg", "image/webp" ]
  },
  "FrontEndUrl": "",
  "FrontEndRoute": {
    "ConfirmAccount": "confirmAccount"
  },
  "AllowCORS": [ "http://localhost:4200", "https://localhost:4200" ],
  "SeedAdmin": {
    "Enabled": true,
    "FirstName": "Admin",
    "LastName": "User",
    "UserName": "Admin",
    "Email": "Admin@Domin.com",
    "Address": "",
    "Password": "Admin1234$"
  },
  "Stripe": {
    "PublishableKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "wwwroot/logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
